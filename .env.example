# 需要真实模型输出时，将本文件复制为 .env，并填写模型服务配置。
# 如果不填写，Saraswati Agent 会使用无需 API Key 的确定性演示模式。

SARASWATI_LLM_BASE_URL=https://api.example.com/v1
SARASWATI_LLM_API_KEY=
SARASWATI_LLM_MODEL=
SARASWATI_EMBEDDING_MODEL=

# 可选的运行参数
SARASWATI_MAX_AGENT_STEPS=4
SARASWATI_RECENT_MESSAGE_LIMIT=16
SARASWATI_RAG_LIMIT=5
SARASWATI_TEMPERATURE=0.8
SARASWATI_TOP_P=1.0
SARASWATI_MAX_OUTPUT_TOKENS=2048
SARASWATI_PRESENCE_PENALTY=0
SARASWATI_FREQUENCY_PENALTY=0
SARASWATI_REQUEST_TIMEOUT=90

# 混合 RAG 权重；运行时会自动按总和归一化
SARASWATI_VECTOR_WEIGHT=0.55
SARASWATI_KEYWORD_WEIGHT=0.25
SARASWATI_IMPORTANCE_WEIGHT=0.15
SARASWATI_RECENCY_WEIGHT=0.05
